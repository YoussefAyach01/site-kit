{
  "name": "site-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Four sellable static business websites (restaurant, barber, dentist, gym) in French and Arabic (RTL).",
  "scripts": {
    "build": "node src/build.ts",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  }
}
